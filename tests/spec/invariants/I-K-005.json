{
  "id": "I-K-005",
  "title": "Override RECURRENCE-ID Is a Candidate Occurrence of Its Main",
  "scope": "CALENDAR",
  "authority": "STORE_POLICY",
  "citations": [
    {
      "doc": "rfc5545.txt",
      "section": "Section 3.8.4.4",
      "line_start": 6377,
      "line_end": 6381,
      "verbatim_quote": "This property is used in conjunction with the \"UID\" and \"SEQUENCE\" properties to identify a specific instance of a recurring \"VEVENT\", \"VTODO\", or \"VJOURNAL\" calendar component. The property value is the original value of the \"DTSTART\" property of the recurrence instance."
    }
  ],
  "statement": "Every override's RECURRENCE-ID, aligned to its main DTSTART, is a candidate occurrence of the main component: generated by DTSTART/RRULE/RDATE, evaluated before EXDATE subtraction.",
  "rationale": "RFC 5545 Section 3.8.4.4 defines RECURRENCE-ID as the original DTSTART of the recurrence instance, so it should name an instance of the set. RFC 8984 Section 4.3.5 does allow overrides that add extra occurrences, so requiring membership is a store policy: it is what lets whole-series edits (R-L4-004/R-L4-005) and truncations prune overrides deterministically.",
  "check": "override_rid_is_candidate",
  "positive_examples": [
    {
      "name": "override_of_generated_instance",
      "description": "RID generated by RRULE.",
      "components": [
        {
          "type": "VEVENT",
          "uid": "s1",
          "summary": "Sync",
          "dtstart": "2025-05-01T09:00:00",
          "dtend": "2025-05-01T10:00:00",
          "rrule": "FREQ=DAILY;COUNT=3",
          "sequence": 0
        },
        {
          "type": "VEVENT",
          "uid": "s1",
          "recurrence_id": "20250502T090000",
          "summary": "Moved",
          "dtstart": "2025-05-02T11:00:00",
          "dtend": "2025-05-02T12:00:00",
          "sequence": 1
        }
      ]
    },
    {
      "name": "override_of_excluded_slot",
      "description": "RID that is also in EXDATE (legacy dual representation).",
      "components": [
        {
          "type": "VEVENT",
          "uid": "s1",
          "summary": "Sync",
          "dtstart": "2025-05-01T09:00:00",
          "dtend": "2025-05-01T10:00:00",
          "rrule": "FREQ=DAILY;COUNT=3",
          "sequence": 0,
          "exdate": [
            "2025-05-02T09:00:00"
          ]
        },
        {
          "type": "VEVENT",
          "uid": "s1",
          "recurrence_id": "20250502T090000",
          "summary": "Moved",
          "dtstart": "2025-05-02T11:00:00",
          "dtend": "2025-05-02T12:00:00",
          "sequence": 1
        }
      ]
    }
  ],
