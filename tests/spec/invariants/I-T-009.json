{
  "id": "I-T-009",
  "title": "Component Order in the Input Does Not Change the Result",
  "scope": "TRANSITION",
  "authority": "STORE_POLICY",
  "citations": [
    {
      "doc": "rfc5546.txt",
      "section": "Section 2.1.5",
      "line_start": 694,
      "line_end": 700,
      "verbatim_quote": "To maximize interoperability and to handle messages that arrive in an unexpected order, use the following rules: 1. The primary key for referencing a particular iCalendar component is the \"UID\" property value."
    }
  ],
  "statement": "Applying the same operation to any permutation of the same input components yields the same success/failure outcome and, on success, the same set of resulting components (compared order-insensitively).",
  "rationale": "Components are identified by (UID, RECURRENCE-ID) (RFC 5546 Section 2.1.5), not by their position in the VCALENDAR; nothing in RFC 5545 gives component order a meaning. A result that depends on whether an override precedes its main component is therefore a store defect (cf. R-L4-001, R-L4-002 edge cases).",
  "check": "order_independent_result",
