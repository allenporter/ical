{
  "id": "I-T-002",
  "title": "Range=NONE Delete Removes Exactly the Targeted Occurrence",
  "scope": "TRANSITION",
  "authority": "RFC_5545",
  "citations": [
    {
      "doc": "rfc5545.txt",
      "section": "Section 3.2.13",
      "line_start": 1323,
      "line_end": 1330,
      "verbatim_quote": "If this parameter is not specified on an allowed property, then the default range is the single instance specified by the recurrence identifier value of the property. The parameter value can only be \"THISANDFUTURE\" to indicate a range defined by the recurrence identifier and all subsequent instances."
    },
    {
      "doc": "rfc5545.txt",
      "section": "Section 3.8.4.4",
      "line_start": 6406,
      "line_end": 6410,
      "verbatim_quote": "The full range of calendar components specified by a recurrence set is referenced by referring to just the \"UID\" property value corresponding to the calendar component. The \"RECURRENCE-ID\" property allows the reference to an individual instance within the recurrence set."
    }
  ],
  "statement": "After a successful single-instance delete (recurrence_id set, Range=NONE) the targeted occurrence slot is absent from the expanded timeline and every other occurrence is unchanged (revision metadata excluded).",
  "rationale": "A deletion addressed to a single instance (RFC 5545 Sections 3.2.13 and 3.8.4.4) must remove that instance and only that instance, whether it was a generated instance or an override.",
  "check": "none_delete_removes_only_occurrence",
  "positive_examples": [
