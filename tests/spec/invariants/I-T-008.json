{
  "id": "I-T-008",
  "title": "A Failed Operation Leaves the State Identical",
  "scope": "TRANSITION",
  "authority": "STORE_POLICY",
  "citations": [],
  "statement": "If an operation is rejected (raises a store error), the calendar state afterwards is exactly the state before, component for component and property for property.",
  "rationale": "The RFCs do not define store transactions; atomic failure is the store contract that lets callers retry or report errors without having to repair partially applied edits (for example a split that truncated the original but failed to insert the new segment).",
  "check": "failed_operation_is_atomic",
  "positive_examples": [
    {
      "name": "rejected_unchanged",
      "description": "Rejected edit, state unchanged.",
      "before": [
        {
