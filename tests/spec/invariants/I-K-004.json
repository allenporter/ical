{
  "id": "I-K-004",
  "title": "Override RECURRENCE-ID Matches the Main DTSTART's Value Type and Floating-ness",
  "scope": "CALENDAR",
  "authority": "RFC_5545",
  "citations": [
    {
      "doc": "rfc5545.txt",
      "section": "Section 3.8.4.4",
      "line_start": 6391,
      "line_end": 6397,
      "verbatim_quote": "This property MUST have the same value type as the \"DTSTART\" property contained within the recurring component. Furthermore, this property MUST be specified as a date with local time if and only if the \"DTSTART\" property contained within the recurring component is specified as a date with local time."
    }
  ],
  "statement": "An override's RECURRENCE-ID is a DATE if and only if its main DTSTART is a DATE, is never a fixed UTC offset, and is floating local time if and only if the main DTSTART is floating local time.",
  "rationale": "RFC 5545 Section 3.8.4.4 requires RECURRENCE-ID to have the same value type as the recurring component's DTSTART, and to be specified as a date with local time if and only if DTSTART is specified as a date with local time. Stored overrides on UTC or TZID series must therefore carry a UTC ('Z') or TZID-qualified RECURRENCE-ID, and overrides surviving a DATE<->DATE-TIME or floating<->zoned change of the main component violate this in either direction.",
  "check": "override_rid_matches_main_form",
  "positive_examples": [
    {
      "name": "datetime_override",
      "description": "Floating series, floating RID.",
      "components": [
        {
          "type": "VEVENT",
          "uid": "s1",
          "summary": "Sync",
          "dtstart": "2025-05-01T09:00:00",
          "dtend": "2025-05-01T10:00:00",
          "rrule": "FREQ=DAILY;COUNT=3",
          "sequence": 0
        },
        {
          "type": "VEVENT",
          "uid": "s1",
          "recurrence_id": "20250502T090000",
          "summary": "Moved",
          "dtstart": "2025-05-02T11:00:00",
          "dtend": "2025-05-02T12:00:00",
          "sequence": 1
        }
      ]
    },
    {
      "name": "date_override",
      "description": "All-day series, DATE RID.",
      "components": [
        {
          "type": "VEVENT",
          "uid": "s1",
          "summary": "Sync",
          "dtstart": "2025-05-01",
          "dtend": "2025-05-02",
          "rrule": "FREQ=DAILY;COUNT=3",
          "sequence": 0
        },
        {
          "type": "VEVENT",
          "uid": "s1",
          "recurrence_id": "20250502",
          "dtstart": "2025-05-02",
          "dtend": "2025-05-03"
        }
      ]
    },
    {
