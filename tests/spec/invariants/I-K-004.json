{
  "id": "I-K-004",
  "title": "Override RECURRENCE-ID Matches the Main DTSTART's Value Type and Floating-ness",
  "scope": "CALENDAR",
  "authority": "RFC_5545",
  "citations": [
    {
      "doc": "rfc5545.txt",
      "section": "Section 3.8.4.4",
      "line_start": 6391,
      "line_end": 6397,
      "verbatim_quote": "This property MUST have the same value type as the \"DTSTART\" property contained within the recurring component. Furthermore, this property MUST be specified as a date with local time if and only if the \"DTSTART\" property contained within the recurring component is specified as a date with local time."
    }
  ],
  "statement": "An override's RECURRENCE-ID is a DATE iff its main DTSTART is a DATE, is never a fixed UTC offset, and is floating whenever the main DTSTART is floating. Notation convention: a RECURRENCE-ID without UTC designator or TZID on a UTC/TZID series denotes local wall-clock time in the series' zone.",
  "rationale": "RFC 5545 Section 3.8.4.4 requires RECURRENCE-ID to have the same value type as the recurring component's DTSTART, and to be a date with local time iff DTSTART is. Overrides surviving a DATE<->DATE-TIME or floating<->zoned change of the main component violate this (review H8).",
  "check": "override_rid_matches_main_form",
  "positive_examples": [
    {
      "name": "datetime_override",
      "description": "Floating series, floating RID.",
      "components": [
        {
          "type": "VEVENT",
          "uid": "s1",
          "summary": "Sync",
          "dtstart": "2025-05-01T09:00:00",
          "dtend": "2025-05-01T10:00:00",
          "rrule": "FREQ=DAILY;COUNT=3",
          "sequence": 0
        },
        {
          "type": "VEVENT",
          "uid": "s1",
          "recurrence_id": "20250502T090000",
          "summary": "Moved",
          "dtstart": "2025-05-02T11:00:00",
          "dtend": "2025-05-02T12:00:00",
          "sequence": 1
        }
      ]
    },
    {
      "name": "date_override",
      "description": "All-day series, DATE RID.",
      "components": [
        {
          "type": "VEVENT",
          "uid": "s1",
          "summary": "Sync",
          "dtstart": "2025-05-01",
          "dtend": "2025-05-02",
          "rrule": "FREQ=DAILY;COUNT=3",
          "sequence": 0
        },
        {
          "type": "VEVENT",
          "uid": "s1",
          "recurrence_id": "20250502",
          "dtstart": "2025-05-02",
          "dtend": "2025-05-03"
        }
      ]
    },
    {
      "name": "tzid_series_local_rid",
      "description": "TZID series, local-notation RID.",
      "components": [
        {
          "type": "VEVENT",
          "uid": "s1",
          "summary": "Sync",
          "dtstart": "2025-05-01T09:00:00-04:00[America/New_York]",
          "dtend": "2025-05-01T10:00:00-04:00[America/New_York]",
          "rrule": "FREQ=DAILY;COUNT=3",
          "sequence": 0
        },
        {
          "type": "VEVENT",
          "uid": "s1",
          "recurrence_id": "20250502T090000",
          "dtstart": "2025-05-02T11:00:00-04:00[America/New_York]",
          "dtend": "2025-05-02T12:00:00-04:00[America/New_York]"
        }
      ]
    }
  ],
