{
  "id": "I-C-010",
  "title": "SEQUENCE Is a Non-Negative Integer",
  "scope": "COMPONENT",
  "authority": "RFC_5545",
  "citations": [
    {
      "doc": "rfc5545.txt",
      "section": "Section 3.8.7.4",
      "line_start": 7876,
      "line_end": 7879,
      "verbatim_quote": "When a calendar component is created, its sequence number is 0. It is monotonically incremented by the \"Organizer's\" CUA each time the \"Organizer\" makes a significant revision to the calendar component."
    }
  ],
  "statement": "When present, SEQUENCE is an integer greater than or equal to 0.",
  "rationale": "RFC 5545 Section 3.8.7.4: a component is created with sequence 0 and the number is only ever incremented, so no reachable value is negative.",
  "check": "sequence_non_negative",
